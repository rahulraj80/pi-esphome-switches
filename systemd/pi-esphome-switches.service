[Unit]
Description=Pi ESPHome Switches (esphome host platform)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/pi-esphome-switches
# Validate config before starting (output goes to journal)
ExecStartPre=/usr/bin/esphome config /opt/pi-esphome-switches/esphome/pi-switches.yaml
# Run esphome host device in the foreground; systemd restarts on failure
ExecStart=/usr/bin/esphome run /opt/pi-esphome-switches/esphome/pi-switches.yaml
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
